# Geheimes Token, das das Frontend als X-Dashboard-Token-Header oder
# ?token=... Query-Parameter mitschicken muss. Ohne dieses Token liefert
# /api/status 401. Erzeugen z.B. mit: openssl rand -hex 32
DASHBOARD_TOKEN=change-me

# Verzeichnis, in dem trade_ledger.json, grid_positions.json,
# trend_ledger.json und allocator_state.json liegen.
# Lokal: Default ist ../data (siehe app/main.py), meist nicht nötig zu setzen.
# Auf dem Homeserver: absoluter Pfad zum data/-Ordner des crypto-bot-Projekts.
DATA_DIR=../data

# Kommagetrennte Liste erlaubter Origins fürs Frontend, oder "*" für alle.
# Für den Start reicht "*"; auf dem Server ggf. auf die konkrete
# Frontend-URL einschränken.
CORS_ORIGINS=*
