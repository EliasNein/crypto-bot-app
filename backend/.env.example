# Geheimes Token, das das Frontend als Header X-Dashboard-Token
# mitschicken muss. Ohne gültiges Token liefern /api/status und
# /api/export/trades 401.
#
# PFLICHT: mindestens 32 Zeichen, kein Platzhalter - der Server
# verweigert sonst den Dienst (500). Weil es bewusst keine
# Rate-Limitierung gibt, ist die Entropie dieses Tokens die einzige
# Schutzschicht, sobald die App über den Cloudflare Tunnel erreichbar ist.
#
# Erzeugen mit:  openssl rand -hex 32
DASHBOARD_TOKEN=HIER-EIGENES-TOKEN-EINSETZEN-openssl-rand-hex-32

# Verzeichnis, in dem trade_ledger.json, grid_positions.json,
# trend_ledger.json und allocator_state.json liegen.
# Lokal: Default ist ../data (siehe app/main.py), meist nicht nötig zu setzen.
# Auf dem Homeserver: absoluter Pfad zum data/-Ordner des crypto-bot-Projekts.
DATA_DIR=../data

# Erlaubte Fremd-Origins fürs Frontend, kommagetrennt.
# LEER LASSEN ist der Normalfall: Frontend und API kommen von derselben
# Adresse, dabei stellt der Browser gar keine CORS-Anfragen. Nur
# eintragen, wenn das Frontend bewusst von einer anderen Domain aus
# betrieben wird ("*" erlaubt jede Herkunft und ist hier unnötig).
CORS_ORIGINS=
